# Shared
NODE_ENV=development

# Backend (REST + chat endpoint)
PORT=3000
DATABASE_URL=postgresql://callflow:callflow_dev_password@localhost:5432/callflow
REDIS_URL=redis://localhost:6379

# OpenRouter aggregates many providers behind one OpenAI-compatible key.
# Get a key at https://openrouter.ai/keys. Pick any model from /models;
# `:free` models cost nothing but are rate-limited.
OPENROUTER_API_KEY=sk-or-v1-...
CHAT_MODEL=deepseek/deepseek-chat-v3-0324:free

# LiveKit (used by backend for token minting and by the agent worker)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxx

# Agent worker - LiveKit-managed inference uses these if you opt in
# (else the worker reads OPENAI_API_KEY, DEEPGRAM_API_KEY, CARTESIA_API_KEY directly)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# API key required by the LiveKit token endpoint. Frontend sends it as
# `x-api-key`. Leave empty in development to bypass.
API_KEY=

# Resend (optional): if set, create_ticket sends a real confirmation email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@example.com
RESEND_TO_EMAIL=

# mem0 (optional): if set, cross-call memory is enabled. Free tier at
# https://app.mem0.ai. Without a key, the system runs but get_caller_context
# returns no memories and SUMMARIZE_CALL workflows no-op.
MEM0_API_KEY=
# Override the LLM used to summarize a call before writing to mem0. Any
# OpenRouter model ID. Defaults to the same as CHAT_MODEL.
MEM0_SUMMARY_MODEL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_KEY=
